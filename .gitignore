.DS_Store
Thumbs.db


# Personal media (contains GPS and timestamps) and derived catalogues: never commit
media/
data/processed/*.csv
data/processed/*.json

# Organiser documents and the unverified dossier copy: keep out of git
data/processed/*.pdf
data/processed/*.csv

# Third-party screenshot of another series: not part of the project
data/raw/track_geometry/Screenshot*

# Extracted video frames (derived from personal media)
data/processed/frames/
data/processed/*.json

# Frontend build and dependencies
frontend/node_modules/
frontend/dist/

# Personal photos for the dashboard slideshow: not committed
frontend/public/slideshow/

# Built from organiser timing and press material; publish only after usage terms are checked
frontend/public/data/

# Generated frontend data and personal photos: never commit
frontend/public/slideshow/
frontend/public/data/
frontend/public/open-photos/
frontend/public/car_photos.json
