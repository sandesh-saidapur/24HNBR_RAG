# Text answers run on Groq (free tier). Photo reading runs on Claude.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown)
TEXT_MODEL=openai/gpt-oss-120b
VISION_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-opus-5-5

# Data
TRACKSIDE_DB_PATH=data/processed/timing.duckdb

# Server (FastAPI). The React dev server runs on port 5173.
API_HOST=127.0.0.1
API_PORT=8000
