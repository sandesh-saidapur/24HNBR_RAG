# LLM Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Data Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
VECTOR_DB_PATH=./data/vector_store/lancedb

# Model Selection
DEFAULT_LLM_PROVIDER=gemini  # Options: anthropic, gemini, openai
VISION_MODEL_NAME=gemini-1.5-flash  # Or claude-3-5-sonnet-20241022
MULTIMODAL_EMBEDDING_MODEL=ViT-B-16-SigLIP  # open_clip model

# Server & UI
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

